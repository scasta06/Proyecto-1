@startuml
title 02-finalizar-venta
actor Comprador
participant GestorComercio as G
participant Venta as V
participant Inventario as I
participant CuentaFidelizacion as C
participant PuntoVenta as P
Comprador -> G: finalizarVenta(v, propina, puntos)
G -> V: isCerrada() / getItems() / requiereInfoAlergenos()
G -> V: isAlergenosInformados()
G -> I: getCantidad(producto, ubicacion)
G -> V: aplicarPropina(propina)
G -> V: calcularTotales(puntoVenta)
V -> P: calcularDescuento(comprador, subtotal)
V -> P: calcularImpuesto(baseGravable)
G -> C: puedeRedimir(puntos)
alt todas las validaciones pasan
G -> V: redimirPuntos(puntos, valor)
G -> V: calcularTotales(puntoVenta) / cerrar()
G -> C: redimir(puntos) / acumular(baseFidelizacion)
G -> I: descontar(producto, ubicacion, cantidad)
G -> P: registrarVenta(v)
G --> Comprador: venta cerrada
else operación rechazada
G --> Comprador: excepción; no se descuenta stock ni puntos
end
@enduml
